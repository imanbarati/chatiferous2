# Your server, for deploy.sh, tools/backup.sh and the tests. Copy to site.env (never committed).
SSH_HOST=you@example.com                 # user@host
SSH_PORT=22
SSH_KEY=$HOME/.ssh/id_ed25519
REMOTE_APP=chatiferous                   # private app folder, relative to your home directory
REMOTE_WEB=public_html/chat              # the web folder (base_url in config.php points here)
REMOTE_PHP=php                           # e.g. /opt/cpanel/ea-php83/root/usr/bin/php on cPanel hosts
SITE_URL=https://example.com/chat/
# Extra first line(s) for web/.htaccess, e.g. on cPanel hosts to pick PHP 8.3:
# HTACCESS_EXTRA='AddHandler application/x-httpd-ea-php83 .php .php8 .phtml'
BACKUP_DIR=$HOME/chatiferous-backups     # tools/backup.sh keeps database dumps and uploads here

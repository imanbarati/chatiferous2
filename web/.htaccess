# Chatiferous. (deploy.sh puts HTACCESS_EXTRA from site.env above this line, e.g. a cPanel
# host's PHP-version handler.)
Options -Indexes

# PHP's own limits are raised for this folder in .user.ini and php.ini beside this file — not
# here: the AddHandler above runs PHP as CGI, where php_value in .htaccess is ignored.
# Neither of those is anybody's business but PHP's.
<FilesMatch "^(php\.ini|\.user\.ini)$">
	Require all denied
</FilesMatch>

# Own rewrite context, so the WordPress/MemberPress rules in the parent folder
# (which send .pdf/.zip/.docx etc. to a paywall script) don't apply here.
RewriteEngine On
RewriteOptions IgnoreInherit

# Hide dotfiles.
RewriteRule (^|/)\. - [F,L]
# App URLs: t/<topic>[/<message>] and messages are served by index.php.
RewriteRule ^(t/\d+(/\d+)?|messages)/?$ index.php [L]
# The Bible reader: read/<BOOK>/<chapter>, and the day's reading
RewriteRule ^read/([A-Za-z0-9]{3})/([0-9]{1,3})/?$ bible.php?b=$1&c=$2 [QSA,L]
RewriteRule ^reading/?$ reading.php [QSA,L]
RewriteRule ^marks/?$ marks.php [QSA,L]
RewriteRule ^reading/([0-9]{4}-[0-9]{2}-[0-9]{2})/?$ reading.php?d=$1 [QSA,L]
# Everything else is served as-is.
RewriteRule ^ - [L]
